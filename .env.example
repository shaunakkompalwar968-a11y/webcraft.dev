# WebCraft.dev - Environment & Configuration Variables Template
# -----------------------------------------------------------------
# If you deploy a serverless function (Vercel, Netlify, or custom Node.js backend)
# use these variables. For client-side static deployment, see config.js.

# Form submission email delivery (e.g. Formspree, Resend, or SendGrid)
FORM_ENDPOINT_URL=https://formspree.io/f/YOUR_FORM_ID
BUSINESS_NOTIFICATION_EMAIL=shaunak.dev@example.com

# WhatsApp Business number (including country code, e.g. 919876543210)
WHATSAPP_PHONE_NUMBER=YOUR_WHATSAPP_NUMBER

# Public site domain
NEXT_PUBLIC_SITE_URL=https://webcraft.dev
